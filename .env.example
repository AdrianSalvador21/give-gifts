# Copia este archivo a .env.local y llena los valores. Nunca subas .env.local.

# Firebase (configuración web) — Consola de Firebase › Configuración del proyecto › Tus apps
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin — Configuración del proyecto › Cuentas de servicio › Generar nueva clave privada
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Pega la clave en una sola línea, con los saltos de línea escritos como \n
FIREBASE_ADMIN_PRIVATE_KEY=

# URL pública de la app, sin diagonal al final. OBLIGATORIA en producción:
# `next build` y `next start` fallan si falta (si no, los links de invitación y de WhatsApp apuntarían a localhost).
# En Vercel: defínela en Production (p. ej. https://givegifts.mx). En Preview, si falta, se usa https://$VERCEL_URL.
# En desarrollo, si falta, se usa http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Las pone Vercel solas (no las definas): VERCEL, VERCEL_ENV, VERCEL_URL.
# Con VERCEL definida se mandan los eventos del embudo a Vercel Web Analytics (eventos personalizados: plan Pro).
